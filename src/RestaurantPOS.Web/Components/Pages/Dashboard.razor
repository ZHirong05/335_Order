@page "/dashboard"
@attribute [Authorize]
@inject IHostEnvironment Environment
@inject IConfiguration Configuration
<PageTitle>@Text["Overview"] · 335 Order</PageTitle>
<div class="dashboard-heading">
    <div><p class="eyebrow">@Text["YOUR DAILY WORKSPACE"]</p><h1>@Text["Ready for service."]</h1><p class="page-subtitle">@Text["Good food. Smooth service. Everything in one place."]</p></div>
    <div class="restaurant-badge"><span>335</span><div>@Text["Restaurant POS"]<small>@Text["Local restaurant workspace"]</small></div></div>
</div>
<section class="service-banner">
    <div><span class="section-kicker">@Text["FROM TABLE TO KITCHEN"]</span><h2>@Text["A little less rush."]<br />@Text["A lot more flow."]</h2><p>@Text["Take an order, keep the kitchen moving,"]<br class="desktop-break" /> @Text["and bring every table together."]</p><AuthorizeView Roles="Admin,Waiter"><a class="action" href="/order">@Text["Start a new order"] <span aria-hidden="true">↗</span></a></AuthorizeView></div>
    <div class="service-illustration" aria-hidden="true"><div class="plate"><div class="plate-inner"><span>335</span><small>@Text["MADE TO SERVE"]</small></div></div><div class="order-slip"><span>@Text["THE NEXT ORDER"]</span><i></i><i></i><i></i><strong>@Text["Freshly prepared."]</strong></div></div>
</section>
<div class="section-heading"><h2>@Text["Choose your workspace"]</h2><span>@Text["One service, working together"]</span></div>
<div class="workspace-grid">
    <AuthorizeView Roles="Admin,Waiter"><a class="workspace-card" href="/order"><span class="workspace-icon waiter-icon" aria-hidden="true">＋</span><span class="card-step">@Text["01 / WAITER"]</span><h3>@Text["Take an order"]</h3><p>@Text["Tables, takeaway, and those"]<br />@Text["little special requests."]</p><span class="card-link">@Text["Open ordering"] <span aria-hidden="true">↗</span></span></a></AuthorizeView>
    <AuthorizeView Roles="Admin,Kitchen"><a class="workspace-card" href="/kitchen"><span class="workspace-icon kitchen-icon" aria-hidden="true">≋</span><span class="card-step">@Text["02 / KITCHEN"]</span><h3>@Text["Keep things cooking"]</h3><p>@Text["See new tickets and let the"]<br />@Text["team know what is ready."]</p><span class="card-link">@Text["Open kitchen"] <span aria-hidden="true">↗</span></span></a></AuthorizeView>
    <AuthorizeView Roles="Admin,Cashier"><a class="workspace-card" href="/cashier"><span class="workspace-icon cashier-icon" aria-hidden="true">▤</span><span class="card-step">@Text["03 / CASHIER"]</span><h3>@Text["Bring up the bill"]</h3><p>@Text["View every order clearly,"]<br />@Text["right down to the last item."]</p><span class="card-link">@Text["Open cashier"] <span aria-hidden="true">↗</span></span></a></AuthorizeView>
</div>
<footer class="dashboard-footer"><span>335 Order <span aria-hidden="true">·</span> @Text["Made for your restaurant"]</span>
@if (!DevelopmentPreview.Enabled(Environment, Configuration)) { <form method="post" action="/auth/logout"><AntiforgeryToken /><button class="quiet-button" type="submit">@Text["Sign out"]</button></form> }
</footer>
