@page "/order"
@page "/order/{Id:guid}"
@attribute [Authorize(Roles = "Admin,Waiter")]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject BusinessNotifications Notifications
@inject OrderService Service
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Nav
<PageTitle>Take an order · 335 Order</PageTitle>
<div class="ordering-content" inert="@(selected != null)">
    @if (step == OrderStep.Table)
    {
        <div class="flow-heading">
            <div><p class="eyebrow">WAITER WORKSPACE</p><h1>Choose a table.</h1><p class="page-subtitle">Every table, ready at a glance.</p></div>
        </div>
    }
    <div class="order-toolbar @(step != OrderStep.Type ? "has-back" : "")">
        <ol class="order-steps" aria-label="Order progress">
            <li class="@(step == OrderStep.Type ? "current-step" : "")"><span class="step-label-full">1. Order type</span><span class="step-label-short">1. Type</span></li>
            @if (type == OrderType.DineIn && step != OrderStep.Type) { <li class="@(step == OrderStep.Table ? "current-step" : "")"><span class="step-label-full">2. Select table</span><span class="step-label-short">2. Table</span></li> }
            <li class="@(step is OrderStep.Food or OrderStep.Actions or OrderStep.Cancel ? "current-step" : "")"><span class="step-label-full">@(type == OrderType.DineIn && step != OrderStep.Type ? "3" : "2"). @(targetOrderId.HasValue && step != OrderStep.Food ? "Manage order" : "Select food")</span><span class="step-label-short">@(type == OrderType.DineIn && step != OrderStep.Type ? "3" : "2"). @(targetOrderId.HasValue && step != OrderStep.Food ? "Order" : "Food")</span></li>
        </ol>
        @if (step != OrderStep.Type) { <button class="secondary-button order-back" disabled="@busy" @onclick="Back">← Back</button> }
    </div>
    @if (success != null) { <p class="notice" role="status">@success</p> }
    @if (error != null) { <div class="notice error" role="alert">@error <button class="secondary-button" disabled="@busy" @onclick="Reload">Refresh data</button></div> }
    @if (menu == null) { <p role="status">Loading menu and tables…</p> }
    else if (step == OrderStep.Type)
    {
        <div class="order-type-grid">
            <button class="selection-card order-type-card" @onclick="() => ChooseType(OrderType.Takeaway)">
                <span class="choice-symbol" aria-hidden="true">↗</span><strong>Take away</strong><span>Pack it up. Choose food and send straight to the kitchen.</span><span class="choice-next">Select food →</span>
            </button>
            <button class="selection-card order-type-card" @onclick="() => ChooseType(OrderType.DineIn)">
                <span class="choice-symbol" aria-hidden="true">▦</span><strong>Dine-in</strong><span>Settle in. Choose a table before adding food.</span><span class="choice-next">Select a table →</span>
            </button>
        </div>
        @if (active.Count > 0)
        {
            <div class="section-heading"><h2>Continue an order</h2><span>Add items to an existing order</span></div>
            <div class="continue-grid">
                @foreach (var o in active)
                {
                    <OrderPreviewCard Order="o" Href="@($"/order/{o.Id}")" />
                }
            </div>
        }
    }
    else if (step == OrderStep.Table)
    {
        <div class="section-heading"><h2>Restaurant tables</h2></div>
        <p class="muted">Choose an available table to start an order, or an occupied table to add more food.</p>
        @if (tables.Count == 0) { <div class="empty-panel">No active tables are configured. You can still create a takeaway order.</div> }
        <div class="table-grid">
            @foreach (var t in tables)
            {
                var occupied = active.FirstOrDefault(o => o.TableId == t.Id);
                <button class="selection-card table-choice @(occupied != null ? "table-occupied" : "")" @onclick="() => ChooseTable(t)">
                    <span class="status-badge @(occupied != null ? "status-occupied" : "status-available")">@(occupied == null ? "Available" : "Occupied")</span>
                    <strong>Table @t.Number</strong><span>@t.Capacity seats</span><span class="choice-next">@(occupied == null ? "Start order →" : "Add to order →")</span>
                </button>
            }
        </div>
    }
    else if (step == OrderStep.Actions && existingBill != null)
    {
        <div class="order-context"><strong>@destination &middot; @existingBill.DisplayNumber</strong><span>Continue an order</span></div>
        @if ((existingBill.Payments?.Count ?? 0) > 0)
        {
            <div class="notice">A payment has been recorded. Complete the remaining balance before closing this order.</div>
        }
        <div class="order-action-grid">
            <button class="selection-card" disabled="@(busy || existingBill.Status == OrderStatus.Closed || (existingBill.Payments?.Count ?? 0) > 0)" @onclick="() => step = OrderStep.Food"><span class="choice-symbol" aria-hidden="true">+</span><strong>Add Item</strong><span>Choose food and add another kitchen ticket.</span></button>
            <button class="selection-card" disabled="@(busy || existingBill.Status == OrderStatus.Closed || (existingBill.Payments?.Count ?? 0) > 0)" @onclick="() => step = OrderStep.Cancel"><span class="choice-symbol" aria-hidden="true">-</span><strong>Cancel Item</strong><span>Select items and quantities to cancel.</span></button>
        </div>
        <section class="current-order-panel"><div class="section-heading"><h2>Your order</h2><span>@existingBill.Items.Sum(i => i.Quantity) items</span></div>
            @foreach (var item in existingBill.Items)
            {
                <div class="saved-order-line @(item.Quantity == 0 ? "cancelled-line" : "")"><strong>@item.Quantity &times; @item.Name</strong>@if (item.Quantity == 0) { <span>Cancelled</span> }@if (item.Notes.Length > 0) { <span>@item.Notes</span> }</div>
            }
        </section>
        @if (existingBill.Status != OrderStatus.Closed) { <div class="order-checkout-actions"><a class="action checkout-order-button" href="@($"/cashier/{targetOrderId}")">@((existingBill.Payments?.Count ?? 0) > 0 ? "Continue payment" : "Checkout") &rarr;</a></div> }
    }
    else if (step == OrderStep.Cancel && existingBill != null)
    {
        <div class="order-context"><strong>@destination &middot; @existingBill.DisplayNumber</strong><span>Cancel Item</span></div>
        <p class="muted">Select the items to cancel. Quantities cannot exceed what remains in the order.</p>
        @foreach (var item in existingBill.Items.Where(i => i.Quantity > 0))
        {
            <div class="cancel-selection-row">
                <label class="cancel-checkbox"><input type="checkbox" disabled="@busy" checked="@cancelSelections.ContainsKey(item.Id)" @onchange="e => SelectCancellation(item.Id, e.Value is true)" /><span><strong>@item.Name</strong><small>@item.Quantity remaining &middot; @item.Notes</small></span></label>
                <label>Cancel quantity<input type="number" min="1" max="@item.Quantity" disabled="@(busy || !cancelSelections.ContainsKey(item.Id))" value="@cancelSelections.GetValueOrDefault(item.Id, 1)" @onchange="e => ChangeCancelQuantity(item.Id, item.Quantity, e.Value?.ToString())" /></label>
            </div>
        }
        <label>Cancellation reason (optional)<textarea maxlength="500" disabled="@busy" @bind="cancelReason" @bind:event="oninput" placeholder="Add a note for the kitchen if needed"></textarea></label>
        <button disabled="@(busy || cancelSelections.Count == 0)" @onclick="SubmitCancellations">@(busy ? "Notifying kitchen..." : "Cancel selected items & notify kitchen")</button>
    }
    else
    {
        <div class="order-context"><strong>@destination @existingBill?.DisplayNumber</strong><span>@(targetOrderId.HasValue ? "Adding items to an existing order" : "New order")</span></div>
        <div class="ordering-layout">
            <section aria-label="Menu">
                <label class="menu-search">Search food or drinks<input type="search" placeholder="Search the menu…" @bind="search" @bind:event="oninput" /></label>
                <div class="category-tabs" aria-label="Menu categories">
                    <button class="category-tab @(categoryId == 0 ? "is-selected" : "")" aria-pressed="@(categoryId == 0 ? "true" : "false")" @onclick="() => categoryId = 0">All</button>
                    @foreach (var group in menu.GroupBy(m => m.CategoryId))
                    {
                        <button class="category-tab @(categoryId == group.Key ? "is-selected" : "")" aria-pressed="@(categoryId == group.Key ? "true" : "false")" @onclick="() => categoryId = group.Key">@group.First().Category.Name</button>
                    }
                </div>
                @if (!FilteredMenu.Any()) { <div class="empty-panel">No items match your search.</div> }
                @foreach (var group in FilteredMenu.GroupBy(m => m.CategoryId))
                {
                    <section class="menu-category">
                        <div class="section-heading"><h2>@group.First().Category.Name</h2><span>@group.Count() items</span></div>
                        <div class="food-grid">
                            @foreach (var item in group)
                            {
                                <button class="selection-card food-choice" disabled="@busy" @onclick="() => OpenPicker(item)">
                                    <span class="food-initial" aria-hidden="true">@(string.IsNullOrWhiteSpace(item.Name) ? "?" : item.Name[..1])</span><strong>@item.Name</strong>
                                    @if (item.Description.Length > 0) { <span>@item.Description</span> }
                                    <span class="food-choice-bottom"><strong>RM @item.Price.ToString("0.00")</strong><span>@(item.Variations.Count > 0 ? "Choose variation +" : "Customize +")</span></span>
                                </button>
                            }
                        </div>
                    </section>
                }
            </section>
            <aside class="order-cart" aria-label="Current order">
                <div class="cart-heading"><h2>Your order</h2><span>@cart.Sum(x => x.Quantity) items</span></div>
                @if (cart.Count == 0) { <div class="empty-cart"><span aria-hidden="true">＋</span><p>Something delicious starts here.</p><small>Select food to choose a variation and add it to your order.</small></div> }
                @foreach (var line in cart)
                {
                    <div class="cart-line" @key="line">
                        <div class="cart-line-heading"><strong>@line.MenuName</strong><button class="cart-remove-button" disabled="@busy" @onclick="() => cart.Remove(line)" aria-label="@($"Remove {line.MenuName} {line.VariationName}")">Remove</button></div>
                        <span class="muted">@line.VariationName · RM @line.UnitPrice.ToString("0.00") each</span>
                        @if (line.Notes.Length > 0) { <p class="cart-notes">@line.Notes</p> }
                        <div class="cart-quantity"><div class="quantity-field"><span>Quantity</span><QuantityInput @bind-Value="line.Quantity" Disabled="busy" /></div><strong>RM @((line.Quantity * line.UnitPrice).ToString("0.00"))</strong></div>
                    </div>
                }
                @if (!targetOrderId.HasValue) { <label>Order notes<textarea maxlength="500" disabled="@busy" placeholder="Any instructions for the whole order?" @bind="notes"></textarea></label> }
                <div class="cart-total"><span>New items total</span><strong>RM @cart.Sum(x => x.Quantity * x.UnitPrice).ToString("0.00")</strong></div>
                <button class="submit-order" disabled="@(busy || cart.Count == 0)" @onclick="Submit">@(busy ? "Sending to kitchen…" : "Send to kitchen →")</button>
            </aside>
        </div>
    }
</div>
@if (selected != null)
{
    <div class="picker-backdrop" @onclick="ClosePicker" @onkeydown="PickerKeyDown">
        <section class="item-picker" role="dialog" aria-modal="true" aria-labelledby="picker-title" tabindex="-1" @ref="picker" @onclick:stopPropagation="true">
            <form @onsubmit="AddToOrder" @onsubmit:preventDefault="true">
                <div class="picker-heading"><div><p class="eyebrow">MAKE IT YOURS</p><h2 id="picker-title">@selected.Name</h2></div><button type="button" class="secondary-button" @onclick="ClosePicker" aria-label="Close food options">✕</button></div>
                <p class="muted">Choose a variation, quantity, and any kitchen notes.</p>
                <fieldset class="variation-fieldset"><legend>Variation</legend><div class="variation-grid">
                    @if (selected.Variations.Count == 0)
                    {
                        <button type="button" class="variation-option is-selected" aria-pressed="true">Standard<strong>RM @selected.Price.ToString("0.00")</strong></button>
                    }
                    @foreach (var option in selected.Variations.OrderBy(x => x.SortOrder))
                    {
                        <button type="button" class="variation-option @(selectedVariationId == option.Id ? "is-selected" : "")" aria-pressed="@(selectedVariationId == option.Id ? "true" : "false")" @onclick="() => selectedVariationId = option.Id">@option.Name<strong>RM @((selected.Price + option.AdditionalPrice).ToString("0.00"))</strong></button>
                    }
                </div></fieldset>
                <div class="quantity-field picker-quantity"><span>Quantity</span><QuantityInput @bind-Value="selectedQuantity" ButtonsOnRight="true" /></div>
                <label>Kitchen notes<textarea maxlength="500" placeholder="For example: no chili, less sugar…" @bind="selectedNotes"></textarea></label>
                @if (pickerError != null) { <p class="error" role="alert">@pickerError</p> }
                <div class="picker-footer"><strong>RM @((PickerPrice * selectedQuantity).ToString("0.00"))</strong><button type="submit" disabled="@(selected.Variations.Count > 0 && !selectedVariationId.HasValue)">Add to order</button></div>
            </form>
        </section>
    </div>
}
@code {
    [Parameter] public Guid? Id { get; set; }
    private enum OrderStep { Type, Table, Food, Actions, Cancel }
    private OrderStep step;
    private List<MenuItem>? menu;
    private List<DiningTable> tables = [];
    private List<Order> active = [];
    private readonly List<CartLine> cart = [];
    private OrderType type = OrderType.Takeaway;
    private int tableId, categoryId;
    private Guid? targetOrderId;
    private string destination = "Take away", search = "", notes = "";
    private bool busy, initialized;
    private Guid? loadedId;
    private string? error, success;
    private Bill? existingBill;
    private readonly Dictionary<Guid, int> cancelSelections = [];
    private string cancelReason = "", cancelKey = Guid.NewGuid().ToString();
    private string key = Guid.NewGuid().ToString();
    private long version;
    private MenuItem? selected;
    private int? selectedVariationId;
    private int selectedQuantity = 1;
    private string selectedNotes = "";
    private string? pickerError;
    private ElementReference picker;
    private bool focusPicker;
    private readonly CancellationTokenSource reconciliationStop = new();
    private Task? reconciliation;
    private bool disposed;
    protected override void OnInitialized() { Notifications.Changed += OrderChanged; reconciliation = PollOrders(); }
    private void OrderChanged(BusinessEvent notification) { if (!disposed) _ = InvokeAsync(ReconcileOrders); }
    private async Task ReconcileOrders()
    {
        if (disposed || busy || selected != null || step is OrderStep.Food or OrderStep.Cancel) return;
        await Reload();
        if (targetOrderId.HasValue && existingBill?.Status == OrderStatus.Closed)
        {
            ClearDraft(); targetOrderId = null; existingBill = null; step = OrderStep.Type; error = null;
            if (Id.HasValue) Nav.NavigateTo("/order");
        }
        StateHasChanged();
    }
    private async Task PollOrders()
    {
        try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5)); while (await timer.WaitForNextTickAsync(reconciliationStop.Token)) await InvokeAsync(ReconcileOrders); }
        catch (OperationCanceledException) { }
    }
    public async ValueTask DisposeAsync() { disposed = true; Notifications.Changed -= OrderChanged; reconciliationStop.Cancel(); if (reconciliation != null) await reconciliation; reconciliationStop.Dispose(); }
    private IEnumerable<MenuItem> FilteredMenu => menu?.Where(m => (categoryId == 0 || m.CategoryId == categoryId) && m.Name.Contains(search, StringComparison.OrdinalIgnoreCase)) ?? [];
    private decimal PickerPrice => (selected?.Price ?? 0m) + (selected?.Variations.FirstOrDefault(v => v.Id == selectedVariationId)?.AdditionalPrice ?? 0m);
    protected override async Task OnParametersSetAsync()
    {
        if (initialized && loadedId == Id) return;
        initialized = true; loadedId = Id; targetOrderId = Id;
        cart.Clear(); notes = ""; key = Guid.NewGuid().ToString(); selected = null;
        step = Id.HasValue ? OrderStep.Actions : OrderStep.Type;
        await Reload();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPicker && selected != null) { focusPicker = false; await picker.FocusAsync(); }
    }
    private async Task Reload()
    {
        try
        {
            menu = await Service.Menu(); active = await Service.Active(); tables = await Service.Tables();
            if (targetOrderId.HasValue)
            {
                existingBill = await Service.Bill(targetOrderId.Value); version = existingBill.Version; destination = existingBill.Destination;
                var current = active.FirstOrDefault(o => o.Id == targetOrderId);
                if (current == null) throw new BusinessException("This order is no longer active.");
                type = current.OrderType; tableId = current.TableId ?? 0;
            }
            error = null;
        }
        catch (BusinessException e) { error = e.Message; }
        catch { error = "Could not load ordering data. Refresh to retry."; }
    }
    private void ChooseType(OrderType value)
    {
        type = value; targetOrderId = null; existingBill = null; tableId = 0; success = null;
        destination = "Take away"; step = value == OrderType.Takeaway ? OrderStep.Food : OrderStep.Table;
    }
    private async Task ChooseTable(DiningTable table)
    {
        type = OrderType.DineIn; tableId = table.Id; destination = $"Table {table.Number}";
        var existing = active.FirstOrDefault(o => o.TableId == table.Id);
        targetOrderId = existing?.Id; version = existing?.Version ?? 0; success = null;
        step = existing == null ? OrderStep.Food : OrderStep.Actions;
        if (existing != null) await Reload();
    }
    private void ClearDraft()
    {
        cart.Clear(); notes = ""; selected = null; key = Guid.NewGuid().ToString();
        search = ""; categoryId = 0;
        cancelSelections.Clear(); cancelReason = ""; cancelKey = Guid.NewGuid().ToString();
    }
    private async Task Back()
    {
        ClearDraft(); error = null; success = null;
        if (targetOrderId.HasValue && step is OrderStep.Food or OrderStep.Cancel) { step = OrderStep.Actions; await Reload(); return; }
        if (targetOrderId.HasValue || Id.HasValue)
        {
            targetOrderId = null; existingBill = null; step = OrderStep.Type;
            if (Id.HasValue) Nav.NavigateTo("/order"); else await Reload();
            return;
        }
        step = step == OrderStep.Food && type == OrderType.DineIn ? OrderStep.Table : OrderStep.Type;
    }
    private void SelectCancellation(Guid itemId, bool selected) { if (selected) cancelSelections[itemId] = 1; else cancelSelections.Remove(itemId); }
    private void ChangeCancelQuantity(Guid itemId, int maximum, string? value)
    {
        if (int.TryParse(value, out var quantity)) cancelSelections[itemId] = Math.Clamp(quantity, 1, maximum);
        else cancelSelections.Remove(itemId);
    }
    private async Task<string> WaiterActor()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        if (!(user.IsInRole("Admin") || user.IsInRole("Waiter"))) throw new BusinessException("Not authorized", 403);
        return user.FindFirstValue(ClaimTypes.NameIdentifier)!;
    }
    private async Task SubmitCancellations()
    {
        if (busy || existingBill == null || !targetOrderId.HasValue) return;
        busy = true; error = null;
        try
        {
            await Service.CancelItems(targetOrderId.Value, new(existingBill.Version, cancelSelections.Select(x => new CancelLineInput(x.Key, x.Value)).ToList(), cancelReason, cancelKey), await WaiterActor());
            ClearDraft(); await Reload(); step = OrderStep.Actions; success = "Cancellation sent to the kitchen.";
        }
        catch (BusinessException ex) { error = ex.Message; }
        catch { error = "Could not confirm cancellation. Retry the same selection or refresh to reconcile."; }
        finally { busy = false; }
    }
    private void OpenPicker(MenuItem item) { selected = item; selectedVariationId = null; selectedQuantity = 1; selectedNotes = ""; pickerError = null; focusPicker = true; }
    private void ClosePicker() => selected = null;
    private void PickerKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") ClosePicker(); }
    private void AddToOrder()
    {
        if (selected == null) return;
        if (selectedQuantity is < 1 or > 99 || selectedNotes.Length > 500) { pickerError = "Choose a quantity from 1 to 99 and notes up to 500 characters."; return; }
        if (selected.Variations.Count > 0 && !selectedVariationId.HasValue) { pickerError = "Choose a variation first."; return; }
        if (cart.Count >= 100) { pickerError = "Send this batch before adding more items (maximum 100 lines)."; return; }
        cart.Add(new() { MenuItemId = selected.Id, MenuName = selected.Name, VariationId = selectedVariationId, VariationName = selected.Variations.FirstOrDefault(v => v.Id == selectedVariationId)?.Name ?? "Standard", UnitPrice = PickerPrice, Quantity = selectedQuantity, Notes = selectedNotes.Trim() });
        selected = null;
    }
    private async Task Submit()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            if (!(user.IsInRole("Admin") || user.IsInRole("Waiter"))) throw new BusinessException("Not authorized", 403);
            if (cart.Any(x => x.Quantity is < 1 or > 99)) throw new BusinessException("Quantities must be from 1 to 99.", 400);
            var items = cart.Select(x => new ItemInput(x.MenuItemId, x.Quantity, x.Notes, x.VariationId)).ToList();
            Guid id;
            if (targetOrderId.HasValue) id = await Service.Add(targetOrderId.Value, new(version, items, key), user.FindFirstValue(ClaimTypes.NameIdentifier)!);
            else id = await Service.Create(new(type, type == OrderType.DineIn ? tableId : null, notes, items, key), user.FindFirstValue(ClaimTypes.NameIdentifier)!);
            ClearDraft(); targetOrderId = null; existingBill = null; step = OrderStep.Type;
            await Reload();
            success = $"Order {active.FirstOrDefault(o => o.Id == id)?.DisplayNumber} sent to the kitchen.";
            if (Id.HasValue) Nav.NavigateTo("/order");
        }
        catch (BusinessException e) { error = e.Message; }
        catch { error = "Could not confirm submission. Retry the same request; it will not create duplicate items."; }
        finally { busy = false; }
    }
    private static string ShortNumber(string number) => number.Length > 20 ? number[..20] + "…" : number;
    private sealed class CartLine
    {
        public int MenuItemId { get; init; }
        public string MenuName { get; init; } = "";
        public int? VariationId { get; init; }
        public string VariationName { get; init; } = "";
        public decimal UnitPrice { get; init; }
        public int Quantity { get; set; }
        public string Notes { get; init; } = "";
    }
}
