@page "/login"
<PageTitle>Sign in · 335 Order</PageTitle>
<h1>Staff sign in</h1>
@if (Failed) { <p role="alert">Sign-in failed. Check your credentials or wait if your account is locked.</p> }
<form method="post" action="/auth/login">
    <AntiforgeryToken />
    <label>Email <input name="email" type="email" required autocomplete="username" /></label>
    <label>Password <input name="password" type="password" required autocomplete="current-password" /></label>
    <button type="submit">Sign in</button>
</form>
<p>First installation? <a href="/setup">Set up administrator</a>.</p>
@code { [SupplyParameterFromQuery(Name = "failed")] public bool Failed { get; set; } }
