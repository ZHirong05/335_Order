@page "/kitchen"
@attribute [Authorize(Roles = "Admin,Kitchen")]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject OrderService Service
@inject BusinessNotifications Notifications
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JS
<PageTitle>@Text["Kitchen display"] · 335 Order</PageTitle>
<h1>@Text["Kitchen display"]</h1>
@if (error != null) { <p class="error" role="alert">@error</p> }
@if (tickets == null) { <p>@Text["Loading kitchen tickets…"]</p> }
else if (tickets.Count == 0) { <p>@Text["No outstanding orders."]</p> }
else
{
    <div class="menu-grid">
    @foreach (var t in tickets)
    {
        <section class="card kitchen-card @(t.Status == KitchenStatus.Cancelled ? "cancelled" : t.Status == KitchenStatus.Ready ? "kitchen-card-ready" : "")">
            <h2>@(t.Order.Table == null ? Text["Takeaway"] : $"{Text["Table"]} {t.Order.Table.Number}")@if (t.Status == KitchenStatus.Preparing) { <br /> } else { <text> · </text> }@StatusLabel(t.Status)</h2>
            <p>@t.Order.DisplayNumber · @t.Order.BusinessDate</p>
            @if (t.Order.Status == OrderStatus.Closed) { <p class="settled-label">@Text["PAID / CHECKED OUT · Continue preparing this ticket"]</p> }
            <p>@(Math.Max(0, (int)(DateTime.UtcNow - t.CreatedAtUtc).TotalMinutes))@(Text.Pick(" minutes elapsed", "分钟前"))</p>
            @foreach (var i in t.Items)
            {
                @if (i.Quantity > i.OrderItem.CancelledQuantity) { <p class="@ItemColor(i.Status)"><strong>@(i.Quantity - i.OrderItem.CancelledQuantity) &times; <ItemName Value="@i.OrderItem.ItemNameSnapshot" /></strong>@if (!string.IsNullOrWhiteSpace(i.NotesSnapshot)) { <span> &middot; @i.NotesSnapshot</span> }</p> }
                @if (i.OrderItem.CancelledQuantity > 0)
                {
                    <p class="kitchen-cancelled"><del>@i.OrderItem.CancelledQuantity &times; <ItemName Value="@i.OrderItem.ItemNameSnapshot" /></del><br /><span>@Text["Cancelled"]</span>@if (!string.IsNullOrWhiteSpace(i.CancellationReason)) { <span> &middot; @i.CancellationReason</span> }</p>
                }
            }
            @if (t.Order.Notes.Length > 0) { <p>@Text["Order notes:"] <strong>@t.Order.Notes</strong></p> }
            @if (t.Status == KitchenStatus.New) { <button disabled="@busy" @onclick="() => Update(t, KitchenStatus.Preparing)">@Text["Start preparing"]</button> }
            @if (t.Status == KitchenStatus.Preparing) { <button disabled="@busy" @onclick="() => Update(t, KitchenStatus.Ready)">@Text["Mark ready"]</button> }
        </section>
    }
    </div>
}
@code {
    private string StatusLabel(KitchenStatus status) => Text[status.ToString()];
    private static string ItemColor(KitchenStatus status) => status switch { KitchenStatus.Preparing => "kitchen-preparing", KitchenStatus.Ready => "kitchen-ready", KitchenStatus.Cancelled => "kitchen-cancelled", _ => "kitchen-added" };
    private List<KitchenTicket>? tickets; private string? error; private bool busy;
    private readonly CancellationTokenSource stop = new(); private Task? reconcile;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (tickets != null) try { await JS.InvokeVoidAsync("kitchenSound.reconcile", (object)tickets.Select(x => x.Id.ToString()).ToArray()); } catch (JSDisconnectedException) { }
    }
    protected override async Task OnInitializedAsync() { Notifications.Changed += Changed; await Reload(); reconcile = Poll(); }
    private void Changed(BusinessEvent e) => _ = InvokeAsync(async () => { await Reload(); StateHasChanged(); });
    private async Task Reload()
    {
        try { tickets = await Service.Tickets(); error = null; }
        catch { error = "Kitchen data unavailable. Retrying automatically…"; }
    }
    private async Task Poll()
    {
        try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5)); while (await timer.WaitForNextTickAsync(stop.Token)) await InvokeAsync(async () => { await Reload(); StateHasChanged(); }); }
        catch (OperationCanceledException) { }
    }
    private async Task Update(KitchenTicket ticket, KitchenStatus status)
    {
        busy = true;
        try
        {
            var u = (await Authentication.GetAuthenticationStateAsync()).User;
            if (!(u.IsInRole("Admin") || u.IsInRole("Kitchen"))) throw new BusinessException("Not authorized", 403);
            await Service.SetTicket(ticket.Id, new(ticket.Order.Version, status), u.FindFirstValue(ClaimTypes.NameIdentifier)!);
            await Reload();
        }
        catch (BusinessException e) { error = e.Message; }
        catch { error = "Update could not be confirmed. Refresh state before retrying."; }
        finally { busy = false; }
    }
    public async ValueTask DisposeAsync() { Notifications.Changed -= Changed; stop.Cancel(); if (reconcile != null) await reconcile; stop.Dispose(); }
}
