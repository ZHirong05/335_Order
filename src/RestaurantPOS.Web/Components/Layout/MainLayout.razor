@inherits LayoutComponentBase

@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration
@inject NavigationManager Nav
@inject IJSRuntime JS
<div class="page">
    <div class="sidebar">
        <a class="brand" href="/dashboard" aria-label="335 Food Gallery home">
            <img class="brand-logo" src="@Assets["images/335-logo.png"]" alt="335 Food Gallery logo" width="174" height="153" />
        </a>
        <div class="nav-caption">@Text["WORKSPACE"]</div>
        <nav class="workspace-nav" aria-label="Main navigation">
            <AuthorizeView Roles="Admin,Waiter"><NavLink href="/order"><span aria-hidden="true">＋</span> @Text["Take orders"]</NavLink></AuthorizeView>
            <AuthorizeView Roles="Admin,Kitchen"><NavLink href="/kitchen"><span aria-hidden="true">≋</span> @Text["Kitchen display"]</NavLink></AuthorizeView>
            <AuthorizeView Roles="Admin,Cashier"><NavLink href="/cashier"><span aria-hidden="true">▤</span> @Text["Cashier"]</NavLink></AuthorizeView>
            <AuthorizeView Roles="Admin,Cashier"><NavLink href="/accounting"><span aria-hidden="true">▣</span> @Text["Accounting"]</NavLink><NavLink href="/statistics"><span aria-hidden="true">▥</span> @Text["Statistics"]</NavLink></AuthorizeView>
            @if (!DevelopmentPreview.Enabled(Environment, Configuration))
            {
                <AuthorizeView><NotAuthorized><NavLink href="/login">@Text["Sign in"]</NavLink></NotAuthorized></AuthorizeView>
            }
        </nav>
        <div class="sidebar-footer">@Text["Made for the everyday rush."]<br /><span>@Text["335 Restaurant POS"]</span></div>
    </div>

    <main>
        <div class="top-row">
            <img class="header-title" src="@Assets["images/335-title.png"]" alt="335 美食阁 · Three Three Five Food Gallery" width="420" height="155" />
            <div class="header-tools">
                <form method="post" action="/language" @ref="languageForm" @onsubmit="ToggleLanguage" @onsubmit:preventDefault="true">
                    <AntiforgeryToken />
                    <input type="hidden" name="language" value="@(Text.Chinese ? "en" : "zh")" />
                    <input type="hidden" name="returnUrl" value="@("/" + Nav.ToBaseRelativePath(Nav.Uri))" />
                    <button type="submit" class="secondary-button language-toggle" disabled="@languageBusy" aria-label="@(Text.Chinese ? "Switch to English" : "切换中文")">@(Text.Chinese ? "English" : "中文")</button>
                </form>
            </div>
        </div>

        <article class="content">
            @if (languageError != null) { <p class="notice error" role="alert">@languageError</p> }
            @Body
        </article>
    </main>
</div>
@code {
    [CascadingParameter(Name = "UiLanguage")] public bool UiLanguage { get; set; }
    private ElementReference languageForm;
    private bool languageBusy;
    private string? languageError;
    private async Task ToggleLanguage()
    {
        if (languageBusy) return;
        languageBusy = true; languageError = null;
        var chinese = !Text.Chinese;
        try { await JS.InvokeVoidAsync("posLanguage.set", languageForm); Text.SetLanguage(chinese); }
        catch { languageError = Text.Pick("Could not change language. Please try again.", "无法切换语言，请重试。"); }
        finally { languageBusy = false; }
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
